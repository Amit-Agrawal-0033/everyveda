{
    "name": "everyveda/ecommerce",
    "description": "EveryVeda.com - Core PHP & MySQL Ayurvedic E-Commerce Platform",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "EveryVeda Engineering Team",
            "email": "dev@everyveda.com"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "razorpay/razorpay": "^2.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "test": "php scripts/test_runner.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
