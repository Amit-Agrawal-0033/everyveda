# EveryVeda.com Environment Configuration
# Copy this file to .env and configure your environment-specific settings.

# Application
APP_NAME="EveryVeda"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://everyveda.com
APP_TIMEZONE="Asia/Kolkata"
APP_DEFAULT_LOCALE=en

# Security & Secrets
APP_KEY=base64:generate_a_random_32_character_string_here
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
CSRF_TOKEN_LIFETIME=3600

# Database Configuration (Aiven Cloud MySQL or Local MySQL)
DB_HOST=mysql-2bddfdd-amithrqgroup-b90a.d.aivencloud.com
DB_PORT=15170
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=Put_Your_Database_Password_Here
DB_CHARSET=utf8mb4
DB_SSL=true

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com/)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Cash On Delivery (1 = Enabled, 0 = Disabled)
ENABLE_COD=1
COD_EXTRA_FEE=0.00

# Shipping Rules (INR)
SHIPPING_FREE_THRESHOLD=499.00
SHIPPING_STANDARD_FEE=50.00

# Tax & Pricing Configuration
PRICES_INCLUDE_TAX=true
SELLER_STATE="Uttar Pradesh"
GST_TAX_RATE=12.00
GSTIN=09AABCE1234F1Z5
FSSAI_LICENSE=12724001000889
AYUSH_LICENSE=UP-AYU-2024-884

# SMTP Transactional Email
MAIL_MAILER=smtp
MAIL_HOST=mail.everyveda.com
MAIL_PORT=587
MAIL_USERNAME=noreply@everyveda.com
MAIL_PASSWORD=YourSmtpPasswordHere
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@everyveda.com
MAIL_FROM_NAME="EveryVeda Organics"
ADMIN_NOTIFICATION_EMAIL=orders@everyveda.com

# Analytics
GA4_MEASUREMENT_ID=
